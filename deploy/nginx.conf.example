# Reemplazar calidad.example.com, certificados y puerto si es staging.
server {
    listen 443 ssl;
    server_name calidad.example.com;
    ssl_certificate /etc/letsencrypt/live/calidad.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/calidad.example.com/privkey.pem;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name calidad.example.com;
    return 301 https://$host$request_uri;
}
